# Nhost project secrets (set in Nhost Dashboard -> Settings -> Secrets; never expose to the web client)
# NHOST_GRAPHQL_URL and HASURA_GRAPHQL_ADMIN_SECRET are supplied by Nhost.
GROQ_API_KEY=
WORKFLOW_ACTIONS_URL=http://host.docker.internal:1337/v1/functions/workflow-actions
NOTIFICATION_DISPATCH_URL=http://host.docker.internal:1337/v1/functions/notification-dispatch
NOTIFICATION_WEBHOOK_URL=

# Web client (NEXT_PUBLIC values are intentionally public)
NEXT_PUBLIC_NHOST_AUTH_URL=http://localhost:1337/v1/auth
NEXT_PUBLIC_NHOST_GRAPHQL_URL=http://localhost:1337/v1/graphql
NEXT_PUBLIC_NHOST_GRAPHQL_WS_URL=ws://localhost:1337/v1/graphql
